# fal.ai credentials — format is "id:secret".
# This key lives only on the backend. Never expose it to the frontend.
FAL_KEY=id:secret

# Approximate USD -> INR conversion used only for display estimates.
USD_TO_INR=90

# Maximum number of images processed concurrently. Backend enforces this ceiling.
MAX_CONCURRENCY=4

# Per-image processing timeout (seconds).
IMAGE_TIMEOUT_SECONDS=180

# Maximum accepted upload size per image (MB).
MAX_FILE_SIZE_MB=50

# How long finished job results are kept on disk before cleanup (minutes).
RESULT_TTL_MINUTES=60

# Backend host/port (optional; defaults shown).
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Skin Fix tool (OpenAI) ---
# Backend only. Required for the Skin Fix tool; the Image Upscaler does not use it.
OPENAI_API_KEY=
# Image edit model. Defaults to gpt-image-2; set gpt-image-1 if your account
# doesn't have gpt-image-2 access.
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Optional: Supabase-backed system settings / prompts store ---
# Leave blank to run fully local (V1 default). When set, editable defaults
# (scale, concurrency, suffix, INR rate) and prompt templates are persisted.
# Both values are BACKEND ONLY. Never put the service key in the frontend.
SUPABASE_URL=https://icszdwcdpipuarsctqfo.supabase.co
# Use the service_role / "secret" key from Project Settings -> API Keys.
SUPABASE_SERVICE_ROLE_KEY=
